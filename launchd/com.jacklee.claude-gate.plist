<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace __HOME__ with your home directory before loading. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jacklee.claude-gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/claude-gate</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.config/claude-gate/watch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.config/claude-gate/watch.log</string>
</dict>
</plist>
